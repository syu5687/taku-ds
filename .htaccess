RewriteEngine On

# ============================================================
# URL正規化：すべて https://taku-ds.jp（www無し・https）に統一
# ============================================================

# 1) www あり → www 無し（httpsで固定）
RewriteCond %{HTTP_HOST} ^www\.taku-ds\.jp$ [NC]
RewriteRule ^(.*)$ https://taku-ds.jp/$1 [R=301,L,NE]

# 2) http → https
#    Cloud Run / Cloudflare はプロキシ経由のため X-Forwarded-Proto で判定する。
#    ※ Cloudflare の SSL/TLS 暗号化モードが「フレキシブル」だと
#      CF→オリジンが http になりループするため、「フル」または「フル（厳格）」にしておくこと。
RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
RewriteRule ^(.*)$ https://taku-ds.jp/$1 [R=301,L,NE]

# ============================================================
# 旧URLからの引き継ぎ（既存ルール）
# ============================================================

# 旧URL1: /main/425.html → 新URL1
RewriteRule ^main/425\.html$ https://taku-ds.jp/camp?tab=eventCalendar [R=301,L]

# 旧URL2: /main/32.html → 新URL2
RewriteRule ^main/32\.html$ https://taku-ds.jp/camp?tab=movingCost [R=301,L]

# 旧URL3: /main.php/565.html → 新URL3
RewriteRule ^main\.php/565\.html$ https://taku-ds.jp/camp?tab=overviewCamp [R=301,L]

# 旧URL4: /main/635.html → 新URL4
RewriteRule ^main/635\.html$ https://taku-ds.jp/about?tab=staff [R=301,L]

# 旧URL5: /main/3.html → 新URL5
RewriteRule ^main/3\.html$ https://taku-ds.jp/licence [R=301,L]

# ============================================================
# パス表記の統一（重複ページ対策）
# ============================================================

# /index.php・/index → /（トップページを1本化）
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L,NE]

# /xxx.php → /xxx（拡張子付きURLを拡張子無しに1本化）
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# ============================================================
# 拡張子省略ルーティング（内部リライト）
# ============================================================
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# 404ハンドラ
ErrorDocument 404 /404.php
